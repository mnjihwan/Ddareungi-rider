# Copy to .env. Keep the Seoul API key out of source control.
SEOUL_API_KEY=
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088
MYSQL_DATABASE=ddareungi
# false: project Docker MySQL (host port 3307, created from the values below).
# true : your own MySQL server. Run scripts/mysql/create-ddareungi-db.sql first, then set host/port.
EXTERNAL_MYSQL=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
# false: project Docker Redis (host port 6380). true: your own Redis (e.g. Memurai on Windows, WSL redis-server).
EXTERNAL_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
MYSQL_USER=ddareungi
MYSQL_PASSWORD=change-local-password
MYSQL_ROOT_PASSWORD=change-local-root-password
COLLECTOR_CRON=0 */5 * * * *
EXTENDED_COLLECTION_ENABLED=true
OD_DOWNLOAD_ENABLED=true
OD_DOWNLOAD_MAX_FILES=7
OD_DOWNLOAD_LOOKBACK_DAYS=14
USAGE_API_KINDS=station-month,day,hour
USAGE_API_LAG_DAYS=5
USAGE_MONTHLY_LOOKBACK=2
# Optional specific periods, e.g. station-month:2026-09,day:2026-10-06,hour:2026-10-06:9
USAGE_BACKFILL_TASKS=

# Optional. Backend Actuator (health/readiness) port, separate from the API port 8080. Default 8090.
# Used by scripts/start-local.* and the Vite /actuator proxy. Docker Compose always uses 8090 inside the container.
# MANAGEMENT_SERVER_PORT=8090

# Optional future AI endpoint; leave blank until a prediction service is available.
VITE_FORECAST_API_PATH=

# Optional legacy provider, only used with routing.provider=ors.
ORS_API_KEY=

# ddareungrider / Kakao Maps: enable Kakao Maps in the developer console first.
# Register http://localhost:5173 and http://127.0.0.1:5173 for the JavaScript key.
KAKAO_MAPS_JAVASCRIPT_KEY=
# Server-side only. Never put this key in a VITE_* variable.
KAKAO_MAPS_REST_API_KEY=
