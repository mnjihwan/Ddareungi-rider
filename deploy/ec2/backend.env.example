# Non-secret backend configuration for EC2. Copy to /etc/ddareungi/backend.env (root:root, 0600) and fill in.
# Read by deploy.sh as `docker run --env-file` (KEY=VALUE per line, no quotes, no `export`).
# Secrets are NOT stored here: put them in SSM Parameter Store as SecureString under SSM_PARAMETER_PATH
# (deploy.env), one parameter per variable, parameter name basename = variable name, single-line values:
#   <SSM_PARAMETER_PATH>MYSQL_PASSWORD
#   <SSM_PARAMETER_PATH>KAKAO_MAPS_REST_API_KEY
#   <SSM_PARAMETER_PATH>SEOUL_API_KEY
#   <SSM_PARAMETER_PATH>ORS_API_KEY            (only when routing.provider=ors)
#   <SSM_PARAMETER_PATH>SPRING_DATA_REDIS_PASSWORD  (only if your Redis requires AUTH; relaxed binding, not in yml)

SPRING_PROFILES_ACTIVE=infra
TZ=Asia/Seoul

# Behind nginx. deploy.sh also forces this (and MANAGEMENT_SERVER_PORT=8090) on `docker run`.
# Must be `native`: the rate limit keys on the client address; a wrong value puts every user behind
# one key (mass HTTP 429). nginx overwrites X-Forwarded-For with $remote_addr (deploy/ec2/nginx/locations.conf).
SERVER_FORWARD_HEADERS_STRATEGY=native

# Same-origin web (nginx serves the web bundle and proxies /api), so CORS stays empty.
# Set comma-separated exact origins only if another origin must call the API.
APP_CORS_ALLOWED_ORIGINS=

# Data stores - user-provided locations (placeholders).
MYSQL_URL=jdbc:mysql://<MYSQL_HOST>:3306/ddareungi?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USER=<MYSQL_USER>
REDIS_HOST=<REDIS_HOST>
REDIS_PORT=6379

SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088

# Rate limit (phase 2 D6 draft numbers, application.yml defaults). Tune after production measurement.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STATIONS_BURST=100
RATE_LIMIT_STATIONS_PER_MINUTE=300
RATE_LIMIT_PLACES_BURST=30
RATE_LIMIT_PLACES_PER_MINUTE=90
RATE_LIMIT_ROUTES_BURST=10
RATE_LIMIT_ROUTES_PER_MINUTE=10

# External provider budgets (application.yml placeholders) and resilience overrides (relaxed binding of
# provider.resilience.*; omit to keep the @DefaultValue defaults).
PLACE_TOTAL_TIMEOUT=3s
ROUTE_TOTAL_TIMEOUT=10s
# PROVIDER_RESILIENCE_RETRY_MAX_RETRIES=1
# PROVIDER_RESILIENCE_CIRCUIT_BREAKER_OPEN_DURATION=30s
# PROVIDER_RESILIENCE_BULKHEAD_ROUTE_MAX_CONCURRENT_CALLS=48

# Freshness boundaries - keep equal to the collector's values.
REALTIME_FRESH_SECONDS=120
REALTIME_MAX_STALE_SECONDS=600

# JVM sizing for the instance (container memory is not limited by deploy.sh).
# JDK_JAVA_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
