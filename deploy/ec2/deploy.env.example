# Host settings for deploy.sh. Copy to /etc/ddareungi/deploy.env (root:root, 0600). Sourced by bash.
# Every value has a default in deploy.sh; only the AWS ones normally need to be set.

AWS_REGION="<AWS_REGION>"                     # e.g. ap-northeast-2 (assumed default region, not verified)
SSM_PARAMETER_PATH=/ddareungi/production/backend/   # SecureString parameters -> backend env (trailing slash)

# BACKEND_ENV_FILE=/etc/ddareungi/backend.env
# DOCKER_NETWORK=ddareungi                    # backend + prometheus share it; actuator 8090 is reached only here
# BLUE_PORT=18081
# GREEN_PORT=18082
# NGINX_UPSTREAM_FILE=/etc/nginx/ddareungi/upstream-backend.conf
# SMOKE_BASE_URL=http://127.0.0.1:18080             # nginx loopback smoke server (was SMOKE_URL before 2026-11-17)
# SMOKE_STATUS_PATH=/api/v1/routes/status            # must answer 200 and "configured":true (unless in maintenance)
# SMOKE_CLIENT_CONFIG_PATH=/api/client-config?platform=web   # "maintenance" must match CLIENT_WEB_MAINTENANCE
# SMOKE_REQUIRE_CONFIGURED=1                         # 0 only while routing keys are deliberately absent
# WEB_SMOKE_URL=http://127.0.0.1:18080/
# WEB_ROOT=/srv/ddareungi/web
# READINESS_TIMEOUT=240                       # catalog load from MySQL must finish within this
# DRAIN_SECONDS=30                            # >= nginx proxy_read_timeout
# STOP_TIMEOUT=30
# ROLLBACK_LOG_LINES=30                       # failed container log lines printed on rollback (masked); they end
#                                             # up in the GitHub Actions log - 0 for a public repository if unsure
